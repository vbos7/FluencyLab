# Monorepo: frontend/ e backend/ têm seus próprios .gitignore específicos.
# Estas regras são um fallback de segurança, caso algo escape das pastas.

**/node_modules/
**/.next/
**/vendor/
**/.env
**/.env.*
!**/.env.example

# Uploads gerados em runtime (avatares do painel admin)
backend/public/uploads/

.DS_Store
.idea/
.claude/
