# Copie para .env e preencha:  cp .env.example .env
#
# Este é o .env do BACKEND (PHP), lido por backend/api/env.php:
#   - php -S no terminal → lê ESTE arquivo (na raiz)
#   - Docker Compose     → variáveis de ambiente (+ as portas lá no fim)
#   - Laravel Forge      → via fastcgi_param no nginx (NÃO este arquivo)
#
# NÃO é versionado — cada pessoa tem o seu.
# O front tem env próprio: frontend/.env.local (veja frontend/.env.example).

# ─── App ─────────────────────────────────────────────────────────────────────
# Origem do Next.js autorizada no CORS (mude só se o dev subir em outra porta).
APP_ORIGIN=http://localhost:3000
# URL pública da aplicação (links de e-mail, RP dos passkeys...).
APP_URL=http://localhost:3000
# Chave de 32 bytes para cifrar segredos de 2FA. Gere com:
#   php -r "echo base64_encode(random_bytes(32));"
APP_KEY=

# ─── Banco compartilhado (DBaaS) ─────────────────────────────────────────────
# Todo mundo aponta pro mesmo banco. O que você apagar some para todos —
# não rode DELETE/DROP sem combinar antes.
DB_HOST=fluencylab.mysql.dbaas.com.br
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# ─── IA ──────────────────────────────────────────────────────────────────────
# Chave da OpenAI (correção dos exercícios por IA).
OPENAI_API_KEY=

# ─── E-mail (SMTP) ───────────────────────────────────────────────────────────
# Usado no "esqueci minha senha". Genérico: funciona com qualquer SMTP.
# Ex. Gmail → host smtp.gmail.com, porta 587, MAIL_PASSWORD = "senha de app" (16 chars).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls          # tls = STARTTLS (587) · ssl = SMTPS (465)
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=           # vazio = usa o MAIL_USERNAME
MAIL_FROM_NAME=FluencyLab

# ─── Terminal / Docker (só dev) ──────────────────────────────────────────────
# Caminho do PHP. Deixe vazio se `php` já funciona no terminal.
# XAMPP/Windows:  PHP_BIN=C:\xampp\php\php.exe
PHP_BIN=
# Portas do docker compose (ignoradas no php -S / npm run dev).
FRONTEND_PORT=3000
BACKEND_PORT=8000
DB_HOST_PORT=3307
