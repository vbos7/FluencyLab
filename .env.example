# Copie para .env e preencha:  cp .env.example .env
#
# O .env é lido por quem precisa dele em cada caminho:
#   - backend/api/env.php   → quando você roda `php -S` no terminal
#   - docker compose        → só as portas lá embaixo
#
# O .env NÃO é versionado. Cada pessoa tem o seu.

# ─── Banco compartilhado (DBaaS) ─────────────────────────────────────────────
# Todo mundo aponta para o mesmo banco, então o schema já vem pronto e ninguém
# precisa recriar nada localmente. Em compensação: o que você apagar aqui some
# para todos. Não rode DELETE/DROP sem combinar antes.
DB_HOST=fluencylab.mysql.dbaas.com.br
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# Origem do Next.js autorizada no CORS.
# Só mude se o `npm run dev` subir em outra porta.
APP_ORIGIN=http://localhost:3000

# Chave da API da OpenAI (correção de exercícios por IA)
OPENAI_API_KEY=

# Caminho do executável do PHP. Deixe VAZIO se `php` já funciona no seu terminal
# (macOS/Linux, ou Windows com o PHP no PATH).
# Preencha se o terminal não acha o php — típico do XAMPP no Windows:
#   PHP_BIN=C:\xampp\php\php.exe
PHP_BIN=

# ─── Só para o caminho alternativo com Docker ────────────────────────────────
# Ignorado quando você roda php -S / npm run dev no terminal.
# Mexa apenas se a porta já estiver ocupada na sua máquina.
# Descubra quem ocupa:  lsof -nP -iTCP:3000 -sTCP:LISTEN
FRONTEND_PORT=3000
BACKEND_PORT=8000
DB_HOST_PORT=3307

# Gere com: php -r "echo base64_encode(random_bytes(32));"
APP_KEY=
