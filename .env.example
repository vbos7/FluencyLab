# Tudo aqui é OPCIONAL — o docker-compose.yml já tem defaults que funcionam.
# Copie para .env (não versionado) só se precisar mudar alguma coisa,
# tipicamente quando uma porta já está ocupada na sua máquina.
#
#   cp .env.example .env
#
# Descubra quem está usando uma porta com:  lsof -nP -iTCP:3000 -sTCP:LISTEN

# --- Portas publicadas no seu host ---
FRONTEND_PORT=3000
BACKEND_PORT=8000

# Porta local do MySQL, para conectar com TablePlus/DBeaver/Sequel Ace.
# Default 3307 e não 3306 para não colidir com um MySQL já instalado.
DB_HOST_PORT=3307

# --- Banco ---
# Usados tanto pelo container do MySQL quanto pelo backend e pelo db-reset.sh.
DB_NAME=fluency_lab
DB_PASS=root

# Chave da API da OpenAI (correção de exercícios por IA)
OPENAI_API_KEY=
