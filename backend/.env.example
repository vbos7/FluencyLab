# Credenciais do banco de dados
# Esses valores são definidos no docker-compose.yml e injetados como variáveis de ambiente.
# Só preencha este arquivo se for rodar o PHP fora do Docker (ex: localmente com XAMPP).
DB_HOST=mysql
DB_NAME=fluency_lab
DB_USER=php_user
DB_PASS=secret

# Chave da API da OpenAI (para correção de exercícios por IA)
# Nunca commite a chave real — coloque só no docker-compose.yml ou num .env local não versionado
OPENAI_API_KEY=
