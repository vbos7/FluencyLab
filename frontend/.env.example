# Copie para .env.local:   cp .env.example .env.local
#
# O Next só lê variáveis de dentro de frontend/, por isso este arquivo existe
# separado do .env da raiz (que é do backend PHP).
#
# NEXT_PUBLIC_ é inlinado no bundle em BUILD time. Se mudar, reinicie o
# `npm run dev` — recarregar a página não basta.
NEXT_PUBLIC_API_URL=http://localhost:8000/api
