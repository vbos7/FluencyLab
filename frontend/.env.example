# Copie para .env.local:   cp .env.example .env.local
#
# O Next só lê variáveis de dentro de frontend/, por isso este arquivo existe
# separado do .env da raiz (que é do backend PHP).
#
# NEXT_PUBLIC_ é inlinado no bundle em BUILD time. Se mudar, reinicie o
# `npm run dev` — recarregar a página não basta. Usada no CLIENTE (navegador).
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Usada no SERVIDOR (Server Components, via fetchFromApi) em RUNTIME. Em produção
# aponte pro backend na MESMA origem (ex.: https://seu-dominio/api); se o servidor
# resolver esse domínio pra si mesmo (ex.: /etc/hosts → 127.0.0.1), a chamada nem
# sai pra internet. Se não definir, o server-api cai no NEXT_PUBLIC_API_URL.
API_BASE_URL=http://localhost:8000/api
