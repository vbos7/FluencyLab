# Copie para .env.local:   cp .env.example .env.local
#
# O Next lê env de dentro de frontend/, separado do .env da raiz (que é do PHP).
# São DUAS URLs de API de propósito — mesma API, pontos de vista diferentes:

# CLIENTE (navegador). Inlinada no bundle em BUILD time — se mudar, rebuild.
# Precisa ser a URL PÚBLICA (o browser do usuário não alcança o localhost do servidor).
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# SERVIDOR (Server Components, via fetchFromApi) em RUNTIME.
# Em produção aponte pro backend LOCAL (loopback), pra não sair pra internet/CDN:
#   API_BASE_URL=http://127.0.0.1:8083/api
# Em dev é o mesmo backend local. Se não definir, o server-api cai no NEXT_PUBLIC_API_URL.
API_BASE_URL=http://localhost:8000/api
